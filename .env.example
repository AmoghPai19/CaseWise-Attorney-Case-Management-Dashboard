# Used by docker-compose.yml when you run `docker compose up`.
# Copy this to `.env` in the repo root and fill in real values.
# This is separate from backend/.env and frontend/.env, which are only
# used when running the servers directly with `npm run dev` (no Docker).

# Secret used to sign JWTs -- set a long random value
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Defaults to the local "mongo" container defined in docker-compose.yml.
# Uncomment and set this to your Atlas connection string instead if you'd
# rather run the containers against Atlas than a local Mongo container.
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/casewise

CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api